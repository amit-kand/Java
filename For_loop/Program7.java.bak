//7)Write a Java program to check whether a given number is prime or not using a for loop.
import java.util.*;
class Program7 
{
	public static void main(String[] args) 
	{
		Scanner s = new Scanner(System.in);
		System.out.print("Enter the any number :");
		int num = s.nextInt();
		int count = 0;
		int num1 = num;
		for (int 2 = 1;i<num;i++)
		{
			if (num%i==0)
			{
				count++;
			}
		}
		if (count ==0)
		{
			System.out.println(num1+" is prime number.");
		}
		else{
			System.out.println(num1+" is not prime number.");
		}
			
	}
}
