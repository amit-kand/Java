//4)Write a Java program to find the sum of numbers from 1 to N.
import java.util.*;
class Program4 
{
	public static void main(String[] args) 
	{
		Scanner s = new Scanner(System.in);
		System.out.print("Enter the number :");
		int num = s.nextInt();
		int sum = 0;
		for (int i = 0;i<=num ;i++ )
		{
			sum = sum+i;
		}
	}
}
