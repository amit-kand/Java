import java.util.*;
class Program8 
{
	public static void main(String[] args) 
	{
		Scanner s = new Scanner(System.in);
		System.out.print("Enter the number :");
		int n = s.nextInt();
		int a = 0;
		int b = 1;
		for (int i = 1;i<=n ;i++ )
		{
			System.out.println(a+" ");
			int c = a + b;
			a = b;
			b = c;
		}
		
		
	}
}
