class Program6
{
	public static void main(String[] args) 
	{
		for(int j = 1;j<=1000;j++){
		int n = j;
		int original = n;
		int sum = 0;
		while(n>0){
			int digit = n% 10;
			int fact = 1;
			for (int i = 1;i<=digit ;i++ )
			{
				fact = fact * i;
				
			}
			sum = sum + fact;
			n = n /10;
		}
		if(sum == original){
			System.out.println(sum);
		}
		}
		
	}
}
