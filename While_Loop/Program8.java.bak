//8).Write a Java program to count the number of digits in a given number.
import java.util.*;
class Program8 
{
	public static void main(String[] args) 
	{
		Scanner s = new Scanner(System.in);
		System.out.print("Enter any digit");
		int digit = s.nextInt();
		int count = 0;
		while (0<digit)
		{
			int na= digit%10;
			count+=1;
			digit = digit/10;
		}
		System.out.println(count);
	}
}
