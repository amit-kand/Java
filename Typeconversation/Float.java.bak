// 5 float to long explicitly;
class Float 
{
	public static void main(String[] args) 
	{
		float a = 1234.090f;
		long b = (long)a;
		System.out.println(b);
		
	}
}

// 6 float to char explicitly;
class Float 
{
	public static void main(String[] args) 
	{
		float a = 1234.090f;
		char b = (char)a;
		System.out.println(b);
		
	}
}